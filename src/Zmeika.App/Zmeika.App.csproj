<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Zmeika.App</RootNamespace>
    <AssemblyName>Zmeika</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zmeika.Core\Zmeika.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="config\game.json" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="config\game.json" LogicalName="Zmeika.App.config.game.json" />
  </ItemGroup>

</Project>
